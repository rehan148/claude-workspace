---
import { APP_STORE_URL, PLAY_URL } from '../config/site';
const { center = true } = Astro.props;
---
<div class="stores" style={center ? '' : 'justify-content:flex-start'}>
  {APP_STORE_URL && (
    <a href={APP_STORE_URL} rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.365 1.43c0 1.14-.42 2.2-1.24 3.06-.98 1.06-2.2 1.65-3.4 1.55-.05-1.1.42-2.24 1.2-3.06.82-.9 2.2-1.55 3.44-1.55zM20.9 17.1c-.55 1.27-.82 1.83-1.53 2.95-.99 1.57-2.39 3.52-4.12 3.54-1.54.02-1.93-1.01-4.02-1-2.09.01-2.53 1.02-4.07 1-1.73-.02-3.05-1.78-4.04-3.35C.35 15.9-.03 11.3 1.53 8.85c1.1-1.74 2.85-2.76 4.5-2.76 1.67 0 2.72 1.02 4.1 1.02 1.34 0 2.16-1.02 4.1-1.02 1.46 0 3.01.8 4.12 2.17-3.62 1.98-3.03 7.15.55 8.84z"/></svg>
      <span><small>Download on the</small>App Store</span>
    </a>
  )}
  {PLAY_URL && (
    <a href={PLAY_URL} rel="noopener">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.6 1.8 13.7 12 3.6 22.2c-.3-.2-.5-.6-.5-1V2.8c0-.4.2-.8.5-1zm11.6 8.7L6.1 1.4l11.3 6.5-2.2 2.6zm0 3 2.2 2.6L6.1 22.6l9.1-9.1zm5.3-3.1c.6.4.6 1.3 0 1.7l-2.4 1.4-2.6-2.6 2.6-2.6 2.4 1.4z"/></svg>
      <span><small>Get it on</small>Google Play</span>
    </a>
  )}
</div>
