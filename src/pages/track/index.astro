---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import { SITE } from '../../config/site';
import { PEPTIDES, CATEGORIES } from '../../data/peptides';
const title = `Peptide Tracking Guides: ${PEPTIDES.length} Compounds With Half-Lives & Schedules`;
const description = `Tracking guides for ${PEPTIDES.length} peptides and injectables: semaglutide, tirzepatide, retatrutide, BPC-157, TB-500, ipamorelin, CJC-1295 and more, with half-life and schedule.`;
---
<Base title={title} description={description} path="/track">
  <div class="wrap"><Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Compounds', href: '/track' }]} /></div>
  <section class="hero" style="padding-top:32px;text-align:left">
    <div class="wrap">
      <h1>Track any peptide</h1>
      <p class="lead" style="margin-left:0">{SITE.name} ships with {SITE.compoundCount}+ compounds. These guides cover the most-used ones: what to log, how often, the half-life and a pre-filled calculator.</p>
    </div>
  </section>
  {CATEGORIES.map((cat) => (
    <section style="padding-top:0">
      <div class="wrap">
        <h2 style="margin-top:0">{cat}</h2>
        <div class="grid">
          {PEPTIDES.filter((p) => p.category === cat).map((p) => (
            <a class="card" href={`/track/${p.slug}`} style="text-decoration:none">
              <h3>{p.name} tracker</h3>
              <p>{p.frequency} · half-life {p.halfLifeText}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
  <Cta />
</Base>
